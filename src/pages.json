{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/login",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "原点智造 ERP"
      }
    },
    {
      "path": "pages/workbench/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/feature/index",
      "style": {
        "navigationBarTitleText": "业务功能"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "apps/inventory/index",
      "style": {
        "navigationBarTitleText": "库存查询",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark",
        "onReachBottomDistance": 50
      }
    },
    {
      "path": "apps/inventory/components/detail",
      "style": {
        "navigationBarTitleText": "库存明细",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    }
  ],
  "tabBar": {
    "color": "#82939d",
    "selectedColor": "#245b78",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/workbench/index",
        "text": "工作台",
        "iconPath": "static/tabbar/workbench.png",
        "selectedIconPath": "static/tabbar/workbench-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "原点智造 ERP",
    "navigationBarBackgroundColor": "#eef3f5",
    "backgroundColor": "#eef3f5"
  }
}
